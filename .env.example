# Nur lokale Entwicklungswerte. Vor einem geteilten Deployment ändern.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
APP_BIND_ADDRESS=127.0.0.1

POSTGRES_DB=sprachplattform
POSTGRES_USER=sprachplattform
POSTGRES_PASSWORD=replace-this-database-password
DATABASE_URL=postgresql://sprachplattform:replace-this-database-password@db:5432/sprachplattform

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CACHE_URL=redis://redis:6379/2

AUDIO_STORAGE_ROOT=/app/var/audio
AUDIO_RETENTION_DAYS=30
# Kurzer Ausklang gegen harte Schnitte/Klicks am Ende jeder TTS-Phrase.
AUDIO_TAIL_FADE_MS=45
AUDIO_TAIL_PADDING_MS=80
ORGANIZATION_MONTHLY_CHARACTER_LIMIT=600000
ORGANIZATION_YEARLY_CHARACTER_LIMIT=7200000

# Serverseitig setzen; niemals in Browser, Git oder Logs ausgeben.
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_MODEL_ID=eleven_v3
TTS_ESTIMATED_EUR_PER_1000_CHARACTERS=0.18
